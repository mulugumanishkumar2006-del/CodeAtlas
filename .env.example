# CodeAtlas Enterprise Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
PROJECT_NAME="CodeAtlas Enterprise"
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (Never commit real production keys)
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://app.codeatlas.io","http://localhost:3000"]

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD
POSTGRES_DB=codeatlas_prod
DATABASE_URL=postgresql://postgres:CHANGE_THIS_POSTGRES_PASSWORD@localhost:5432/codeatlas_prod

# -----------------------------------------------------------------------------
# REDIS & QUEUE CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# AI SERVICES (Optional - Core repository intelligence works without LLM keys)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# RATE LIMITING & SECURITY BOUNDARIES
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
MAX_REPOSITORY_SIZE_MB=500
MAX_GRAPH_NODES=50000
